    "livekit-server-sdk": "^2.19.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@iconify-json/ph": "^1.2.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.1",
    "@typescript-eslint/parser": "8.71.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
