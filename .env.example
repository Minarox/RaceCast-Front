# LiveKit server the car publishes to. The browser gets the URL with its token;
# the key and secret never leave the server.
LIVEKIT_URL="wss://live.example.com"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_ROOM="racecast"

# Identity of the car's participant (LIVEKIT_IDENTITY on the car).
# Leave empty to treat whichever participant is not a viewer as the car.
LIVEKIT_CAR_IDENTITY=""

# Map tiles. Defaults to the OpenStreetMap Foundation tile server (moderate use
# only: https://operations.osmfoundation.org/policies/tiles/). Switch provider
# here, keeping its attribution. TILE_DARKEN inverts light tiles to fit the
# dark theme; set it to false for a provider with dark tiles.
# TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
# TILE_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>"
# TILE_MAX_ZOOM="19"
# TILE_DARKEN="true"

# Public origin of the site. Read at BUILD time (canonical URL, and the host
# allowed to set X-Forwarded-For, which the token rate limit relies on).
SITE_URL="https://racecast.example.com"

# Port the standalone server listens on (defaults to 4321).
PORT="4321"
